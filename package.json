{
  "name": "agenda-desktop",
  "version": "1.0.0",
  "description": "Desktop application for managing calendar, email, and tasks.",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev:client": "cd client && npm run dev",
    "electron:start": "node electron/main.cjs",
    "dev": "npm run electron:start && npm run dev:client",
    "build:client": "npm run build:client",
    "build:electron": "electron-builder --win --mac --linux",
    "install": "npm install && npm run dev"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.63",
    "@types/react-dom": "^18.2.49",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "pg": "^8.21.0",
    "sequelize": "^6.32.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}

